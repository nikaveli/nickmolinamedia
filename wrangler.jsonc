{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nickmolinamedia",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "nickmolinamedia.com", "custom_domain": true },
    { "pattern": "www.nickmolinamedia.com", "custom_domain": true }
  ]
}
